# 复制本文件为 .env 后填写。不要将 .env 提交到 Git。
CLASSASSIGN_USERNAME=admin
CLASSASSIGN_PASSWORD=
CLASSASSIGN_SECRET=

CLASSASSIGN_HOST=127.0.0.1
CLASSASSIGN_PORT=8765
CLASSASSIGN_SECURE_COOKIE=0

# 本地运行可留空；Render 部署时填写 Upstash 控制台提供的 REST 信息。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CLASSASSIGN_STATE_KEY=classassign:state:v1
